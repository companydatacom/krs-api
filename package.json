{
  "name": "@companydata/krs-api",
  "version": "0.2.0",
  "description": "KRS API wrapper: Polish company data from the KRS (Krajowy Rejestr Sądowy) and CEIDG with full addresses, phone, email, website and firmographics, through one REST call. A thin layer over @companydata/companydata-sdk, pinned to PL.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run",
    "publish:public": "npm publish --access public",
    "test:live": "npx -y tsx examples/quickstart.ts"
  },
  "keywords": [
    "krs",
    "krs-api",
    "nip",
    "regon",
    "ceidg",
    "poland",
    "polish",
    "rejestr",
    "company-data",
    "business-register",
    "company-search",
    "b2b-data",
    "sdk",
    "typescript"
  ],
  "homepage": "https://companydata.com/krs-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/companydatacom/krs-api.git"
  },
  "bugs": {
    "url": "https://github.com/companydatacom/krs-api/issues"
  },
  "dependencies": {
    "@companydata/companydata-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
